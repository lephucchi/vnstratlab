# Copy to `.env` (in the project folder or the app home) and fill in what you use.
# Never commit `.env`. Run `vnstratlab doctor` to see which values are set (never their values).

# Where vnstratlab keeps data, config and logs. Default: the platform user-data dir.
# APP_HOME=D:/vnstratlab-home

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Obsolete: old vnstock keys stopped working on 2026-11-10. Phase 1 runs on synthetic data
# until a source is chosen (docs/adr/ADR-006-synthetic-first.md). Leave empty.
VNSTOCK_API_KEY=

# Optional Telegram report.
# TELEGRAM_BOT_TOKEN: the token BotFather gives you when you create the bot.
# TELEGRAM_CHAT_ID: where the bot posts. Send your bot a message, open
#   https://api.telegram.org/bot<token>/getUpdates and copy "chat":{"id": ...}
#   (a number; group ids start with -100).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PO dashboard login (maintainers only; used by the Pages build, set as GitHub secrets there).
# Use a random password of 16+ characters: the encrypted data is public, so only the
# password's strength protects it. Leading/trailing spaces are ignored.
PO_USERNAME=
PO_PASSWORD=
