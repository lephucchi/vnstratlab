# Copy to `.env` (in the project folder or the app home) and fill in what you use.
# Never commit `.env`. Run `vnstratlab doctor` to see which values are set.

# Where vnstratlab keeps data, config and logs. Default: platform user-data dir.
# VNSTRATLAB_HOME=D:/vnstratlab-home

# Log level: DEBUG, INFO, WARNING, ERROR
VNSTRATLAB_LOG_LEVEL=INFO

# Market data provider key (only if your chosen source needs one).
VNSTRATLAB_DATA_API_KEY=

# Optional Telegram report.
VNSTRATLAB_TELEGRAM_BOT_TOKEN=
VNSTRATLAB_TELEGRAM_CHAT_ID=

# Phase 2 news scoring with an LLM.
VNSTRATLAB_LLM_API_KEY=

# PO dashboard login. Used only when building the Pages site (GitHub secrets of the same
# names in CI); the dashboard data is encrypted with a key derived from these values.
VNSTRATLAB_PO_USER=
VNSTRATLAB_PO_PASSWORD=
